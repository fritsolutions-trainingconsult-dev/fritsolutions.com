rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function newRegistration() {
      return request.resource.data.keys().hasOnly(['first_name','last_name','dob','phone','email','course_id','course_name','status','source','created_at'])
        && request.resource.data.keys().hasAll(['first_name','last_name','dob','phone','email','course_id','course_name','status','source','created_at'])
        && request.resource.data.first_name is string
        && request.resource.data.first_name.size() > 0
        && request.resource.data.first_name.size() < 101
        && request.resource.data.last_name is string
        && request.resource.data.last_name.size() > 0
        && request.resource.data.last_name.size() < 101
        && request.resource.data.course_name is string
        && request.resource.data.course_name.size() > 0
        && request.resource.data.course_name.size() < 201
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 41
        && request.resource.data.email is string
        && request.resource.data.email.size() < 201
        && (request.resource.data.dob == null || request.resource.data.dob is string)
        && (request.resource.data.course_id == null || request.resource.data.course_id is string)
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'website'
        && request.resource.data.created_at == request.time;
    }

    function newMessage() {
      return request.resource.data.keys().hasOnly(['first_name','last_name','email','message','status','source','created_at'])
        && request.resource.data.keys().hasAll(['first_name','last_name','email','message','status','source','created_at'])
        && request.resource.data.first_name is string
        && request.resource.data.first_name.size() > 0
        && request.resource.data.first_name.size() < 101
        && request.resource.data.last_name is string
        && request.resource.data.last_name.size() > 0
        && request.resource.data.last_name.size() < 101
        && request.resource.data.email is string
        && request.resource.data.email.size() > 2
        && request.resource.data.email.size() < 201
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5001
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'website'
        && request.resource.data.created_at == request.time;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /registrations/{id} {
      allow create: if newRegistration() || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Visitors can send a message but can NEVER read messages
    match /messages/{id} {
      allow create: if newMessage() || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
